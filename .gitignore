node_modules/
dist/
.astro/
.wix/
.env
.env.*
!.env.example
*.log
.DS_Store

# Photos of students live in Google Drive / Wix media, not in git (docs/PHOTOS.md).
/public/gal/*
!/public/gal/.gitkeep
/public/media/

# Real inventory exports (CSV from the Google Sheet) are team data: never commit them.
# Only the made-up test fixtures are allowed.
/apps/inventory/**/*.csv
!/apps/inventory/test/fixtures/**/*.csv

# Generated by integrations/sync-media.mjs from packages/assets, sites/*/media and apps/*/media.
/public/assets/
/public/favicon.ico
/public/favicon-32.png
/public/apple-touch-icon.png
/public/icon-*.png
/dist-mock/
/test-results/
