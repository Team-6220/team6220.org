# Base URL that serves the public site's photos (no trailing slash). Leave unset to use the copies in the repo (/assets/main).
PUBLIC_MEDIA_BASE=

# Inventory app data. Unset: `pnpm build` uses Wix, `pnpm dev` and tests use mock data.
# Set to "mock" or "wix" to override (see apps/inventory/README.md).
# PUBLIC_INVENTORY_BACKEND=

# Site Manager (/apps/site), Wix build only. SERVER secrets for /api/site live in the Wix dashboard's Secrets Manager
# (read by src/server/wix-secrets.ts), never in the repo or the browser. Names only here; see docs/SITE-MANAGER.md
# for how to create the GitHub App. Form signups need no secret (the server reads them with elevated permissions).
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY=          # PKCS#8 PEM ("BEGIN PRIVATE KEY"); newlines may be written as \n
# SITE_MANAGER_GITHUB_TOKEN=       # alternative to the three above: one ready token (Contents + Pull requests write)
# SITE_MANAGER_GITHUB_REPO=        # optional, default Team-6220/team6220.org
# Wix login and hosting: `wix env pull` writes WIX_CLIENT_ID, WIX_CLIENT_INSTANCE_ID, WIX_CLIENT_PUBLIC_KEY and
# WIX_CLIENT_SECRET to .env.local (git-ignored). Only WIX_CLIENT_ID is public. The static build needs none of them.
# Build variables (not secrets). PUBLIC_WIX_BUILD is set by astro.config.mjs on the Wix build: form signups then use the
# real server. PUBLIC_SITE_MANAGER_API=on also makes Submit open real pull requests instead of running in demo mode
# (needs the GitHub secrets).
# PUBLIC_SITE_MANAGER_API=on

# The inventory import script (apps/inventory/scripts/import-from-sheet.mjs) reads WIX_API_KEY and WIX_SITE_ID
# from your shell for a single run. Never put real values in any file in this repo.

# Operations apps (Icarus, Production, BOM). Unset: `pnpm build` uses Wix and /api/ops, `pnpm dev` and tests use
# made-up data. Set to "mock" or "wix" to override (see docs/operations/ARCHITECTURE.md).
# PUBLIC_OPS_BACKEND=
# SERVER secrets for /api/ops, /api/ops-timer and /api/github-hook also live in the Wix Secrets Manager. Names only:
# APOLLO_KEY_SHA256, TBA_KEY, TEAM_NUMBER, GITHUB_TOKEN, GITHUB_SYNC_PAUSED, GITHUB_WEBHOOK_SECRET, OPS_TIMER_SECRET
# (what each is for: docs/operations/SERVER.md).
