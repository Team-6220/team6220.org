# Base URL that serves student photos (no trailing slash). Leave unset for local /media.
PUBLIC_MEDIA_BASE=

# Inventory app data: "mock" (demo data, nothing saved; the default) or "wix" (the Wix CMS collections).
# See apps/inventory/README.md before switching to "wix".
PUBLIC_INVENTORY_BACKEND=mock

# The inventory import script (apps/inventory/scripts/import-from-sheet.mjs) reads WIX_API_KEY and WIX_SITE_ID
# from your shell for a single run. Never put real values in any file in this repo.
