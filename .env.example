# Base URL that serves the public site's photos (no trailing slash). Leave unset to use the copies in the repo (/assets/main).
PUBLIC_MEDIA_BASE=

# Inventory app data. Unset: `pnpm build` uses Wix, `pnpm dev` and tests use mock data.
# Set to "mock" or "wix" to override (see apps/inventory/README.md).
# PUBLIC_INVENTORY_BACKEND=

# Site Manager (/apps/site), Phase 2 only. SERVER secrets for /api/site: set them in Wix (secrets), never in the repo
# or the browser. Names only here; see docs/SITE-MANAGER.md for how to create the GitHub App.
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY=          # PKCS#8 PEM ("BEGIN PRIVATE KEY"); newlines may be written as \n
# SITE_MANAGER_GITHUB_TOKEN=       # alternative to the three above: one ready token (Contents + Pull requests write)
# SITE_MANAGER_GITHUB_REPO=        # optional, default Team-6220/team6220.org
# Build variable (not a secret): makes /apps/site call /api/site instead of running in demo mode.
# PUBLIC_SITE_MANAGER_API=on

# The inventory import script (apps/inventory/scripts/import-from-sheet.mjs) reads WIX_API_KEY and WIX_SITE_ID
# from your shell for a single run. Never put real values in any file in this repo.

# Operations apps (Icarus, Production, BOM). Unset: `pnpm build` uses Wix and the ops API, `pnpm dev` and tests use
# made-up data. Set to "mock" or "wix" to override (see docs/operations/ARCHITECTURE.md).
# PUBLIC_OPS_BACKEND=
# The ops API's /exec URL (not a secret). Normally pasted into packages/data/src/config.ts instead.
# PUBLIC_OPS_API_URL=
