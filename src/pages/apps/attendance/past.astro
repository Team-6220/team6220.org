---
// /apps/attendancepast: meeting attendance (https://github.com/Team-6220/team6220.org/wiki/Operations-Attendance).
import AppLayout from "../../../layouts/AppLayout.astro";
import { Attendance } from "@team6220/attendance";
import "@team6220/attendance/attendance.css";
---

<AppLayout title="Attendance | Los Al Robotics" description="Los Al Robotics (FRC Team 6220) meeting attendance.">
  <Attendance client:only="react" screen="past">
    <main class="t-page" slot="fallback"><p class="t-muted">Loading attendance…</p></main>
  </Attendance>
  <noscript><p class="t-page">Attendance needs JavaScript turned on.</p></noscript>
</AppLayout>
