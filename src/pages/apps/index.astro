---
// /apps: Home, the first screen of the Home app (apps/dashboard). The main site's "Log In" link points here.
// /apps/all (All apps) and /apps/account (Account and settings) are the Home app's other screens.
import AppLayout from "../../layouts/AppLayout.astro";
import { Dashboard } from "@team6220/dashboard";
import "@team6220/dashboard/dashboard.css";
---

<AppLayout title="Team apps | Los Al Robotics" description="Sign in to Los Al Robotics (FRC Team 6220) team apps.">
  <Dashboard client:only="react" screen="home">
    <div class="k-screen" slot="fallback"><p class="k-hint">Loading team apps…</p></div>
  </Dashboard>
  <noscript><p class="k-screen">Team apps need JavaScript turned on.</p></noscript>
</AppLayout>
