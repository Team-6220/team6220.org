---
// /apps/inventory: the team inventory. This is the ORIGINAL Apps Script UI (apps/inventory/ui, unchanged), put
// together at build time the way Apps Script did it (Index.html with its includes filled in), plus:
//   - the google.script stub (apps/inventory/shim/google-script-stub.js), which must run before the UI's scripts;
//   - a sign-in gate (#ggi-gate) shown until the member's session is checked;
//   - apps/inventory/shim/main.ts, which checks the session and answers google.script.run with @team6220/data.
// No site layout on purpose: the original page brings its own fonts, styles and logos.
import { APP_TITLE, assembleIndex } from "../../../../apps/inventory/shim/assemble.ts";
import stub from "../../../../apps/inventory/shim/google-script-stub.js?raw";

const files = import.meta.glob<string>("../../../../apps/inventory/ui/*.html", { query: "?raw", import: "default", eager: true });
const page = assembleIndex(files);
---

<!doctype html>
<html lang="en" data-ggi="checking">
  <head>
    <Fragment set:html={page.head} />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <meta name="description" content="Team inventory: parts, tools, audits and the packing list. For Los Al Robotics team members." />
    <title>{APP_TITLE}</title>
    <style is:inline>
      /* Until the sign-in check is done (and instead of the app when it fails), show #ggi-gate. */
      html:not([data-ggi="ready"]) #app { display: none; }
      html[data-ggi="ready"] #ggi-gate { display: none; }
      #ggi-gate a.btn { text-decoration: none; }
      /* PLACEHOLDER (#106): plain link back to the main site; placement is for the owner's design pass. */
      html:not([data-ggi="ready"]) .ggi-back { display: none; }
      .ggi-back { position: fixed; right: 12px; bottom: 12px; z-index: 50; text-decoration: none; }
      .ggi-gate-wings { display: block; width: min(280px, 70vw); height: auto; margin: 0 auto 20px; }
    </style>
    <script is:inline set:html={stub} />
  </head>
  <body>
    <div id="ggi-gate" role="status"><div class="loading"><div class="spinner"></div>Loading inventory…</div></div>
    <a class="btn ggi-back" href="/">Team site</a>
    <Fragment set:html={page.body} />
    <noscript><p style="padding:16px">The inventory needs JavaScript.</p></noscript>
    <script>
      import "../../../../apps/inventory/shim/main.ts";
    </script>
  </body>
</html>
