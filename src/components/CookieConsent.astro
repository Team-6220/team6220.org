---
// Cookie policy, with no visible banner (https://github.com/Team-6220/team6220.org/wiki/History-Phase-2). On Wix hosting, Wix's scripts set up
// `window.consentPolicyManager`; its default lets every cookie category run until a visitor chooses. Nothing here asks the
// visitor, so this switches everything except essential cookies (sign-in, site basics) off for every visitor who has not
// chosen. If we ever add analytics, bring a notice back (git history has one) or set the site-wide policy instead.
// Where there is no consent manager (the static test build) it does nothing at all.
// Docs: https://dev.wix.com/docs/go-headless/wix-managed-headless/full-integration-astro/feature-guides/manage-cookie-consent
---

<script is:inline>
  (function () {
    var OFF = { functional: false, analytics: false, advertising: false, dataToThirdParty: false };

    function start() {
      var manager = window.consentPolicyManager;
      var current = manager.getCurrentConsentPolicy();
      if (current && current.defaultPolicy) manager.setConsentPolicy(OFF);
    }

    if (window.consentPolicyManager) start();
    else window.addEventListener("consentPolicyManagerReady", start, { once: true });
  })();
</script>
