---
// Cookie policy and notice (docs/PHASE-2.md). On Wix hosting, Wix's scripts set up `window.consentPolicyManager`; its
// default lets every cookie category run until a visitor chooses. Until the visitor chooses, this keeps everything
// except essential cookies (sign-in, site basics) off, and shows a small notice with "Allow analytics" and "No thanks".
// Where there is no consent manager (the static test build, dev.team6220.org) it does nothing at all.
// Docs: https://dev.wix.com/docs/go-headless/wix-managed-headless/full-integration-astro/feature-guides/manage-cookie-consent
---

<script is:inline>
  (function () {
    var KEY = "team6220.cookieNotice";
    var OFF = { functional: false, analytics: false, advertising: false, dataToThirdParty: false };
    var ON = { functional: true, analytics: true };

    function seen() {
      try { return localStorage.getItem(KEY) === "1"; } catch (e) { return false; }
    }
    function remember() {
      try { localStorage.setItem(KEY, "1"); } catch (e) { /* storage blocked: the notice shows again next time */ }
    }

    function showNotice(manager) {
      var box = document.createElement("div");
      box.className = "cookie-notice";
      box.setAttribute("role", "region");
      box.setAttribute("aria-label", "Cookies");

      var text = document.createElement("p");
      text.textContent =
        "We use cookies that keep you signed in and the site working. We'd also like to count visits to see what's useful. " +
        "Analytics stay off unless you allow them.";

      var buttons = document.createElement("div");
      buttons.className = "cookie-notice__buttons";
      function button(label, primary, policy) {
        var b = document.createElement("button");
        b.type = "button";
        b.textContent = label;
        if (primary) b.className = "cookie-notice__primary";
        b.addEventListener("click", function () {
          manager.setConsentPolicy(policy);
          remember();
          box.remove();
        });
        return b;
      }
      buttons.appendChild(button("Allow analytics", true, ON));
      buttons.appendChild(button("No thanks", false, OFF));

      box.appendChild(text);
      box.appendChild(buttons);
      document.body.appendChild(box);
    }

    function start() {
      var manager = window.consentPolicyManager;
      var current = manager.getCurrentConsentPolicy();
      if (current && current.defaultPolicy) manager.setConsentPolicy(OFF);
      if (seen()) return;
      if (document.body) showNotice(manager);
      else document.addEventListener("DOMContentLoaded", function () { showNotice(manager); }, { once: true });
    }

    if (window.consentPolicyManager) start();
    else window.addEventListener("consentPolicyManagerReady", start, { once: true });
  })();
</script>

<style is:global>
  .cookie-notice {
    position: fixed; z-index: 2000; left: 12px; right: 12px; bottom: 12px; max-width: 640px; margin-inline: auto;
    display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; padding: 14px 16px; border-radius: 6px;
    background: #111; color: #fff; border: 1px solid #ffa300; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    font: 500 0.9rem/1.4 "Jura", system-ui, sans-serif;
  }
  .cookie-notice p { margin: 0; flex: 1 1 260px; }
  .cookie-notice__buttons { display: flex; gap: 8px; }
  .cookie-notice button {
    min-height: 44px; padding: 8px 14px; border-radius: 4px; border: 2px solid #ffa300; background: transparent; color: #fff;
    font: inherit; font-weight: 700; cursor: pointer;
  }
  .cookie-notice button.cookie-notice__primary { background: #ffa300; color: #000; }
  .cookie-notice button:focus-visible { outline: 3px solid #fff; outline-offset: 2px; }
</style>
