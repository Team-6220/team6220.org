---
// Page shell for team apps under /apps: shared tokens from @team6220/ui, no main-site styles.
import BaseLayout from "./BaseLayout.astro";
import ThemeToggle from "@team6220/ui/ThemeToggle.astro";
import "@team6220/ui/tokens.css";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Jura:wght@400;500;600;700&display=swap" />
    <!-- Apply the saved light/dark choice before the page is drawn (the button is ThemeToggle.astro). Default: dark. -->
    <script is:inline>
      try {
        document.documentElement.dataset.theme = localStorage.getItem("team6220.theme") === "light" ? "light" : "dark";
      } catch (e) {
        document.documentElement.dataset.theme = "dark";
      }
    </script>
  </Fragment>
  <slot />
  <ThemeToggle />
  <!-- Same page-change logic as the main site (hover prefetch). Only Inventory plays the loader animation, from its own page; see sites/main/README.md. -->
  <script is:inline src="/assets/shared/scripts/page-nav.js"></script>
</BaseLayout>
