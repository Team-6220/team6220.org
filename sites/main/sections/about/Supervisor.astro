---
// About page: our on-campus supervisor, Mr. Jones. The pickles, flasks and molecules are decoration (aria-hidden).
// Each icon is one entry in DECOR: which drawing, where (percent of the card), size, and tilt.
const DECOR = [
  { icon: "pickle", x: 3, y: 8, size: 54, rot: -24 },
  { icon: "flask", x: 88, y: 6, size: 48, rot: 12 },
  { icon: "molecule", x: 93, y: 62, size: 52, rot: -8 },
  { icon: "pickle", x: 80, y: 86, size: 44, rot: 32 },
  { icon: "beaker", x: 1, y: 70, size: 46, rot: 10 },
  { icon: "molecule", x: 46, y: 90, size: 34, rot: 20 },
  { icon: "pickle", x: 55, y: 2, size: 36, rot: 70 },
];
---

<section id="supervisor">
  <div class="wrap">
    <div class="supervisor rv">
      <div class="sup-decor" aria-hidden="true">
        {DECOR.map((d) => (
          <svg class={`sup-${d.icon}`} style={`left:${d.x}%;top:${d.y}%;width:${d.size}px;height:${d.size}px;transform:rotate(${d.rot}deg)`}><use href={`#sup-${d.icon}`} /></svg>
        ))}
      </div>
      <p class="eyebrow">Our supervisor</p>
      <h2 class="title-calm">Mr. Jones</h2>
      <p>Mr. Jones teaches AP Chemistry, was named Los Alamitos High School's 2025 Teacher of the Year, and represents our team on campus. Every meeting in our shop happens because he's there.</p>
      <ul class="sup-facts">
        <li><b>Subject</b> AP Chemistry</li>
        <li><b>Honors</b> LAHS Teacher of the Year, 2025</li>
        <li><b>Pickles</b> Enthusiast, not lover. There's a difference.</li>
        <li><b>Pets</b> Guinea pigs</li>
      </ul>
      <a class="sweep" href="http://www.pickleland.epizy.com/aboutteacher.htm" target="_blank" rel="noopener">Visit Mr. Jones's site ↗</a>
    </div>
  </div>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <symbol id="sup-pickle" viewBox="0 0 48 48"><path d="M12 37c-6-6-4-17 6-25s20-6 21 0-6 17-14 23-10 5-13 2z" fill="#6aa03f" stroke="#2f5e1f" stroke-width="2.5"/><g fill="#2f5e1f"><circle cx="20" cy="20" r="1.6"/><circle cx="27" cy="16" r="1.6"/><circle cx="31" cy="23" r="1.6"/><circle cx="23" cy="28" r="1.6"/><circle cx="16" cy="30" r="1.6"/></g></symbol>
    <symbol id="sup-flask" viewBox="0 0 48 48"><path d="M18 5h12M20 5v13L9 39a4 4 0 0 0 3.6 5.5h22.8A4 4 0 0 0 39 39L28 18V5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/><path d="M13.5 32h21l3.5 7.5a2.5 2.5 0 0 1-2.3 3.5H12.3A2.5 2.5 0 0 1 10 39.5z" fill="#ffa300"/></symbol>
    <symbol id="sup-beaker" viewBox="0 0 48 48"><path d="M10 6h28M13 6v34a3 3 0 0 0 3 3h16a3 3 0 0 0 3-3V6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/><path d="M14.5 26h19v14a1.5 1.5 0 0 1-1.5 1.5H16a1.5 1.5 0 0 1-1.5-1.5z" fill="#6aa03f"/><path d="M30 13h5M30 19h5" stroke="currentColor" stroke-width="2"/></symbol>
    <symbol id="sup-molecule" viewBox="0 0 48 48"><g stroke="currentColor" stroke-width="2.5"><path d="M24 24 10 14M24 24l15-8M24 24v16"/></g><circle cx="24" cy="24" r="6" fill="#ffa300"/><circle cx="10" cy="14" r="4.5" fill="currentColor"/><circle cx="39" cy="16" r="4.5" fill="currentColor"/><circle cx="24" cy="40" r="4.5" fill="#6aa03f"/></symbol>
  </svg>
</section>
