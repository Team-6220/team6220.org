---
// About page: our mentors. Names and roles from the team intro deck; confirm each mentor is OK with being listed.
const MENTORS = [
  { name: "Bruce Riedinger", role: "Mechanical", text: "A retired Boeing engineer whose experience guides the technical and mechanical direction of our designs." },
  { name: "Tamas Vejsz", role: "Design and management", text: "An experienced engineering manager who provides oversight and direction for the team." },
  { name: "Laura Hall", role: "Electrical", text: "A senior hardware engineer at Broadcom who teaches our electrical team best practices for wiring." },
  { name: "Lee Tokuda", role: "Programming", text: "An experienced software engineer who helps our programmers write efficient code and improve how they develop it." },
];
---

<section id="mentors" class="on-paper">
  <div class="wrap">
    <div class="sec-head rv"><div><p class="eyebrow ruled">The adults behind us</p><h2 class="title-calm">Our mentors</h2></div><p>Mentors teach, keep the shop safe and give advice. Students make the calls.</p></div>
    <div class="mentors">
      {MENTORS.map((m, i) => (
        <article class="rv" style={`--d:${i}`}><p class="eyebrow">{m.role}</p><h3>{m.name}</h3><p>{m.text}</p></article>
      ))}
    </div>
    <p class="mentor-cta rv">Want to mentor? <a href="/sponsors">Tell us how you'd like to help →</a></p>
  </div>
</section>
