---
import { media } from "../../lib/media";
---

<section class="on-paper angled angled-gold">
  <div class="wrap">
    <figure class="pit-photo photo-card tl-l rv"><div class="pc-in"><img src={media("team/b5ea775824.webp")} alt="Team 6220's pit at competition under The Golden Griffins banner with sponsor logos" loading="lazy"></div></figure>
    <div class="why rv" aria-label="Why sponsor Team 6220">
      <div><b>2016</b><span>competing in FIRST since our rookie year</span></div>
      <div><b>$6K</b><span>raised by our student-run 2025 summer camp</span></div>
      <div><b>60%</b><span>of camp attendees joined the team</span></div>
    </div>
    <div class="has-dots"><svg class="deco dots dots-tiers" aria-hidden="true"><rect width="100%" height="100%" fill="url(#dotk)"/></svg><div class="tiers">
      <article class="tier rv" style="--d:0"><h3>Lion</h3><p class="amt">Up to $1,000</p><p class="muted" style="font-size:.9rem">Monetary donations, goods, or services</p>
        <ul><li>Logo on our website, robot, and team T-shirts</li><li>Workshop and testing-field tours on request</li><li>Thank-you letter and regular team updates</li><li>Invitations to local tournaments and team events</li></ul></article>
      <article class="tier rv" style="--d:1"><h3>Eagle</h3><p class="amt">Up to $2,500</p><p class="muted" style="font-size:.9rem">Monetary donations, goods, or services</p>
        <ul><li>Logo on promotional and technical materials</li><li>A dedicated social media post</li><li>Everything in Lion</li></ul></article>
      <article class="tier top rv" style="--d:2"><span class="badge">TOP TIER</span><h3>Griffin</h3><p class="amt">Over $2,500</p><p style="font-size:.9rem">Monetary donations, goods, or services</p>
        <ul><li>Most prominent logo spot on the robot and promo material</li><li>Robot demo and team appearance at your company event (within travel distance)</li><li>A team T-shirt</li><li>Everything in Lion and Eagle</li></ul></article>
    </div></div>
    <div class="sponsor-cta">
      <a class="btn btn-black" href="https://docs.google.com/presentation/d/1iuF2NAVTilYF-3i4U-3p_zf2lG8_ntdAB4D0URpIYwc/edit" target="_blank" rel="noopener">Open sponsorship packet ↗</a>
    </div>
    <div class="biz-mail"><span>Email our business team</span><div class="copy-row"><code>operations@team6220.org</code><button class="copy-btn" type="button" data-copy="operations@team6220.org">COPY</button></div></div>
  </div>
</section>
<section id="budget" class="on-paper" style="padding-top:0">
  <div class="wrap budget-wrap">
    <div class="rv">
      <p class="eyebrow ruled" style="margin-bottom:10px">Where your money goes</p>
      <h2 class="title-calm" style="font-size:clamp(1.6rem,3vw,2.2rem)">2025–26 season budget: $45,000</h2>
      <p class="muted">Robot parts are the biggest line: motors, electronics, aluminum, polycarbonate, filament, gears, and sprockets. The rest covers FRC registration, workshop tools, travel, marketing, and summer camp kits.</p>
      <p class="give-note">Make checks payable to <strong>Los Al Robotics</strong> (501(c)(3), EIN 93-3891396). Hand them to your student contact, drop by our workshop at Los Al High, or mail them to the address in the packet.</p>
    </div>
    <ul class="budget rv" aria-label="Season budget by category">
      <li title="Robot components: $19,000 (42%)"><span>Robot components</span><span class="bar" aria-hidden="true"><i style="--w:100%"></i></span><span class="v">$19,000</span></li>
      <li title="FRC registration: $9,000 (20%)"><span>FRC registration</span><span class="bar" aria-hidden="true"><i style="--w:47.4%"></i></span><span class="v">$9,000</span></li>
      <li title="Workshop supplies: $9,000 (20%)"><span>Workshop supplies</span><span class="bar" aria-hidden="true"><i style="--w:47.4%"></i></span><span class="v">$9,000</span></li>
      <li title="Travel and food: $3,000 (7%)"><span>Travel &amp; food</span><span class="bar" aria-hidden="true"><i style="--w:15.8%"></i></span><span class="v">$3,000</span></li>
      <li title="Marketing: $3,000 (7%)"><span>Marketing</span><span class="bar" aria-hidden="true"><i style="--w:15.8%"></i></span><span class="v">$3,000</span></li>
      <li title="Training and summer camp: $2,000 (4%)"><span>Training &amp; camp</span><span class="bar" aria-hidden="true"><i style="--w:10.5%"></i></span><span class="v">$2,000</span></li>
      <li class="total"><span>Total</span><span></span><span class="v">$45,000</span></li>
    </ul>
  </div>
</section>
<section id="sponsor-list">
  <div class="wrap">
    <div class="sec-head rv"><div><p class="eyebrow ruled">Our sponsors</p><h2 class="title-calm">Thank you</h2></div><p>The companies and partners on our banner this season.</p></div>
    <ul class="wall">
      <li class="rv" style="--d:0"><img class="lg lg-rtx" src="/assets/main/a26bfa3ebe.png" alt="RTX (Raytheon)"></li><li class="rv" style="--d:1"><img class="lg lg-boeing" src="/assets/main/b3be6afd52.png" alt="Boeing"></li><li class="rv" style="--d:2"><img class="lg lg-ctc" src="/assets/main/da3cc89f9b.png" alt="CTC Global"></li><li class="rv" style="--d:3"><img class="lg lg-laef" src="/assets/main/8c2f2817ef.png" alt="Los Alamitos Education Foundation"></li><li class="rv" style="--d:4"><img class="lg lg-ptsa" src="/assets/main/438993a9c5.png" alt="Los Alamitos High School PTSA"></li><li class="rv" style="--d:5"><img class="lg lg-lausd" src="/assets/main/62b28bae94.png" alt="Los Alamitos Unified School District"></li><li class="rv" style="--d:5"><img class="lg lg-runsealbeach" src="/assets/main/0a53b7fcd5.png" alt="Run Seal Beach"></li><li class="rv" style="--d:5"><img class="lg lg-simkin" src="/assets/main/13c4548884.png" alt="Terry Simkin"></li><li class="rv lg-text" style="--d:5">Gene Haas Foundation</li><li class="tbd rv" style="--d:5"><a href="/sponsors">Your company here →</a></li>
    </ul>
  </div>
</section>
