---
// The Sponsors page (#161, #162, #163). Order: why sponsor (stats and who you reach), tiers, packet + inquiry form,
// budget, the sponsor wall grouped by tier, mentor/volunteer form, and other ways to help.
// The forms post to Wix Forms (sites/main/scripts/site-b.js); Wix emails each submission to operations@team6220.org.
// Sponsors, their logos and tiers: sites/main/content/sponsors.json (Site Manager). The packet: public/sponsorship-packet.pdf.
import { renderSponsorWall, TIERS } from "@team6220/content";
import { media } from "../../lib/media";
import { SPONSORS } from "../../data/sponsors";

// Wall groups, top tier first. Sponsors without a tier are listed last under "Supporters".
const GROUPS = [...TIERS.filter((t) => t !== "").reverse(), ""].map((tier) => ({
  title: tier ? `${tier} tier` : "Supporters",
  list: SPONSORS.filter((s) => s.tier === tier),
})).filter((g) => g.list.length);

/** Update the size when the packet is replaced. */
const PACKET = { href: "/sponsorship-packet.pdf", title: "2026 Sponsorship Packet", size: "PDF, 3 MB" };
---

<section class="on-paper angled angled-gold">
  <div class="wrap">
    <figure class="pit-photo photo-card tl-l rv"><div class="pc-in"><img src={media("team/b5ea775824.webp")} alt="Team 6220's pit at competition under The Golden Griffins banner with sponsor logos" loading="lazy"></div></figure>
    <div class="why rv" aria-label="Why sponsor Team 6220">
      <div><b>48</b><span>student members this season</span></div>
      <div><b>7,500</b><span>average digital impressions a month, across our social media and website</span></div>
      <div><b>1,000s</b><span>of students, families and engineers see your logo at every <i>FIRST</i> event</span></div>
    </div>
    <div class="reach rv" aria-label="Who you reach">
      <article><p class="eyebrow">At competitions</p><h3>On the robot, the banner and our shirts</h3><p>Your logo travels with us to every <i>FIRST</i> event, where thousands of students, families, mentors and engineers see it in the stands and in the pits.</p></article>
      <article><p class="eyebrow">At our own events</p><h3>Student to student</h3><p>Hundreds of face-to-face conversations at the STEM Expo, our Open Workshop days and our summer camp, with middle and high school students who love STEM.</p></article>
      <article><p class="eyebrow">Online</p><h3>About 7,500 views a month</h3><p>Sponsor posts and thank-yous on our social media, and your logo on this website all season.</p></article>
    </div>
    <div class="has-dots"><svg class="deco dots dots-tiers" aria-hidden="true"><rect width="100%" height="100%" fill="url(#dotk)"/></svg><div class="tiers">
      <article class="tier rv" style="--d:0"><h3>Lion</h3><p class="amt">Up to $1,000</p><p class="muted" style="font-size:.9rem">Monetary donations, goods, or services</p>
        <ul><li>Logo on our website, robot, and team T-shirts</li><li>Workshop and testing-field tours on request</li><li>Thank-you letter and regular team updates</li><li>Invitations to local tournaments and team events</li></ul></article>
      <article class="tier rv" style="--d:1"><h3>Eagle</h3><p class="amt">Up to $2,500</p><p class="muted" style="font-size:.9rem">Monetary donations, goods, or services</p>
        <ul><li>Logo on promotional and technical materials</li><li>A dedicated social media post</li><li>Everything in Lion</li></ul></article>
      <article class="tier top rv" style="--d:2"><span class="badge">TOP TIER</span><h3>Griffin</h3><p class="amt">Over $2,500</p><p style="font-size:.9rem">Monetary donations, goods, or services</p>
        <ul><li>Most prominent logo spot on the robot and promo material</li><li>Robot demo and team appearance at your company event (within travel distance)</li><li>A team T-shirt</li><li>Everything in Lion and Eagle</li></ul></article>
    </div></div>
  </div>
</section>
<section id="sponsor-us" class="on-paper" style="padding-top:0">
  <div class="wrap join-grid">
    <div class="packet rv">
      <p class="eyebrow ruled">Sponsorship packet</p>
      <h2 class="title-calm">{PACKET.title}</h2>
      <p>Everything in one place: who we are, where the money goes, and what each tier includes. Send it to anyone at your company who should see it.</p>
      <a class="btn btn-black" href={PACKET.href} download>Download the packet</a>
      <p class="packet-size">{PACKET.size}</p>
      <div class="biz-mail"><span>Email our business team</span><div class="copy-row"><code>operations@team6220.org</code><button class="copy-btn" type="button" data-copy="operations@team6220.org">COPY</button></div></div>
    </div>
    <div class="photo-card still rv" style="--d:1"><form class="form pc-in" id="sponsor-form" novalidate aria-labelledby="s-form-h">
      <h3 id="s-form-h">Ask about sponsoring</h3>
      <div class="field"><label for="s-name">Name</label><input id="s-name" name="name" autocomplete="name" aria-describedby="s-name-err" required><span class="err" id="s-name-err" hidden>Enter your name.</span></div>
      <div class="field"><label for="s-company">Company or organization</label><input id="s-company" name="company" autocomplete="organization"></div>
      <div class="field"><label for="s-email">Email</label><input id="s-email" name="email" type="email" autocomplete="email" aria-describedby="s-email-err" required><span class="err" id="s-email-err" hidden>Enter an email address like name@example.com.</span></div>
      <div class="field"><label for="s-phone">Phone (optional)</label><input id="s-phone" name="phone" type="tel" autocomplete="tel"></div>
      <div class="field"><label for="s-message">How would you like to help?</label><textarea id="s-message" name="message" rows="4"></textarea></div>
      <button class="btn btn-gold" type="submit">Send</button>
      <p class="ok" id="s-ok" role="status" hidden></p>
    </form></div>
  </div>
</section>
<section id="budget" class="on-paper" style="padding-top:0">
  <div class="wrap budget-wrap">
    <div class="rv">
      <p class="eyebrow ruled" style="margin-bottom:10px">Where your money goes</p>
      <h2 class="title-calm" style="font-size:clamp(1.6rem,3vw,2.2rem)">2026–27 season budget: $45,000</h2>
      <p class="muted">Robot parts are the biggest line: motors, electronics, aluminum, polycarbonate, filament, gears, and sprockets. The rest covers FRC registration, workshop tools, travel, marketing, and summer camp kits.</p>
      <p class="give-note">Make checks payable to <strong>Los Al Robotics</strong> (501(c)(3), EIN 93-3891396). Hand them to your student contact, drop by our workshop at Los Al High, or mail them to the address in the <a href={PACKET.href}>packet</a>.</p>
    </div>
    <ul class="budget rv" aria-label="Season budget by category">
      <li title="Robot components: $19,000 (42%)"><span>Robot components</span><span class="bar" aria-hidden="true"><i style="--w:100%"></i></span><span class="v">$19,000</span></li>
      <li title="FRC registration: $9,000 (20%)"><span>FRC registration</span><span class="bar" aria-hidden="true"><i style="--w:47.4%"></i></span><span class="v">$9,000</span></li>
      <li title="Workshop supplies: $9,000 (20%)"><span>Workshop supplies</span><span class="bar" aria-hidden="true"><i style="--w:47.4%"></i></span><span class="v">$9,000</span></li>
      <li title="Travel and food: $3,000 (7%)"><span>Travel &amp; food</span><span class="bar" aria-hidden="true"><i style="--w:15.8%"></i></span><span class="v">$3,000</span></li>
      <li title="Marketing: $3,000 (7%)"><span>Marketing</span><span class="bar" aria-hidden="true"><i style="--w:15.8%"></i></span><span class="v">$3,000</span></li>
      <li title="Training and summer camp: $2,000 (4%)"><span>Training &amp; camp</span><span class="bar" aria-hidden="true"><i style="--w:10.5%"></i></span><span class="v">$2,000</span></li>
      <li class="total"><span>Total</span><span></span><span class="v">$45,000</span></li>
    </ul>
  </div>
</section>
<section id="sponsor-list">
  <div class="wrap">
    <div class="sec-head rv"><div><p class="eyebrow ruled">Our sponsors</p><h2 class="title-calm">Thank you</h2></div><p>Your support makes our mission possible.</p></div>
    {GROUPS.map((g) => (
      <div class="wall-group">
        <h3 class="wall-tier rv">{g.title}</h3>
        <ul class="wall"><Fragment set:html={renderSponsorWall(g.list)} /></ul>
      </div>
    ))}
    <a class="btn btn-gold wall-cta rv" href="#sponsor-us">Your company here: become a sponsor →</a>
  </div>
</section>
<section id="volunteer" class="on-paper angled angled-gold">
  <div class="wrap join-grid">
    <div class="rv">
      <p class="eyebrow ruled">Mentor or volunteer</p>
      <h2 class="title-calm">Give your time</h2>
      <p>Students lead this team, and the adults around them make it possible. Tell us how you'd like to help and we'll email you about next steps.</p>
      <div class="reach reach-stack" aria-label="Ways to help">
        <article><p class="eyebrow">Industry mentors</p><p>Engineers and professionals who coach a subteam: design, manufacturing, programming, electrical or business. Students make the decisions; you share what you know.</p></article>
        <article><p class="eyebrow">Parent volunteers</p><p>Help at competitions, with food and driving, with fundraising, or through the booster club.</p></article>
        <article><p class="eyebrow">Alumni</p><p>Come back to help with fall training, at events, or as a mentor for the subteam you were on.</p></article>
      </div>
    </div>
    <div class="photo-card still rv" style="--d:1"><form class="form pc-in" id="volunteer-form" novalidate aria-labelledby="v-form-h">
      <h3 id="v-form-h">Volunteer with us</h3>
      <div class="field"><label for="v-name">Name</label><input id="v-name" name="name" autocomplete="name" aria-describedby="v-name-err" required><span class="err" id="v-name-err" hidden>Enter your name.</span></div>
      <div class="field"><label for="v-email">Email</label><input id="v-email" name="email" type="email" autocomplete="email" aria-describedby="v-email-err" required><span class="err" id="v-email-err" hidden>Enter an email address like name@example.com.</span></div>
      <div class="field"><label for="v-phone">Phone (optional)</label><input id="v-phone" name="phone" type="tel" autocomplete="tel"></div>
      <fieldset class="checks" aria-describedby="v-roles-err"><legend>I'd like to help as</legend>
        <label><input type="checkbox" value="Industry mentor">Industry mentor</label>
        <label><input type="checkbox" value="Parent volunteer">Parent volunteer</label>
        <label><input type="checkbox" value="Alumni">Alumni</label>
        <span class="err" id="v-roles-err" hidden>Pick at least one.</span>
      </fieldset>
      <div class="field"><label for="v-background">Your background or skills (optional)</label><textarea id="v-background" name="background" rows="3"></textarea></div>
      <div class="field"><label for="v-availability">When are you available? (optional)</label><textarea id="v-availability" name="availability" rows="2"></textarea></div>
      <button class="btn btn-gold" type="submit">Send</button>
      <p class="ok" id="v-ok" role="status" hidden></p>
    </form></div>
  </div>
</section>
<section id="wishlist" class="on-gold">
  <div class="wrap rv">
    <p class="eyebrow ruled">Other ways to help</p>
    <h2 class="title-calm">Materials, time and know-how count too</h2>
    <p class="wish-text">Raw stock, machining time, electronics, software licenses, shipping and mentoring hours all count toward the same tiers as a cash gift. Or pick something from our Amazon wishlist: it lists the parts, tools, and supplies our students use to build and maintain the robot.</p>
    <div class="sponsor-cta" style="margin-top:0">
      <a class="btn btn-black" href="https://www.amazon.com/hz/wishlist/ls/2XCLFBYGO6WMT" target="_blank" rel="noopener">Open our Amazon wishlist ↗</a>
      <a class="btn btn-grey" href="#sponsor-us">Offer something else</a>
      <a class="btn btn-grey" href="#volunteer">Mentor or volunteer</a>
    </div>
  </div>
</section>
