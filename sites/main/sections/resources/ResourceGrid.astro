---
// Everything on /resources, in sections. Cards come from sites/main/content/resources.json (via data/resources.ts) and data/apps.ts.
import { renderResourceCards } from "@team6220/content";
import { ARCHIVE, RESOURCES } from "../../data/resources";
import { APPS, APPS_DASHBOARD } from "../../data/apps";
import Placeholder from "../../components/Placeholder.astro";
---

<section class="on-gold angled" id="team-resources">
  <div class="wrap">
    <div class="res">
      <Fragment set:html={renderResourceCards(RESOURCES)} />
    </div>
  </div>
</section>

<section class="on-ink">
  <div class="wrap">
    <div class="sub-head rv" id="apps" style="margin-top:0"><div><h2 class="ruled title-calm">Apps</h2></div><a class="btn btn-line" href={APPS_DASHBOARD.href}>Open the apps dashboard →</a></div>
    <div class="res res-dark">
      {APPS.map((a, i) => (
        <a class="rv" style={`--d:${i}`} href={a.href}><span class="k">APP</span><h3>{a.name}</h3><p>{a.blurb}</p></a>
      ))}
    </div>

    <div class="sub-head rv" id="media"><div><h2 class="ruled title-calm">Media</h2></div><a class="btn btn-gold" href="/resources/media">See all media →</a></div>

    <div class="sub-head rv" id="archive"><div><h2 class="ruled title-calm">Archive</h2></div></div>
    {ARCHIVE.length > 0 ? (
      <div class="res res-dark">
        <Fragment set:html={renderResourceCards(ARCHIVE)} />
      </div>
    ) : (
      <Placeholder issue="Archive of technical and team binders, kept for future seasons" />
    )}
  </div>
</section>
