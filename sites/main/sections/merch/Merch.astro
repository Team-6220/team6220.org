---
import { merchCount, renderMerchItems } from "@team6220/content";
import { MERCH } from "../../data/merch";
---

<section class="on-paper angled angled-gold">
  <div class="wrap">
    <div class="sec-head rv"><div><p class="eyebrow ruled">{merchCount(MERCH.items.length)}</p><h2 class="title-calm">Team gear</h2></div><p>Tap any item to open it in the store and pick your size and color.</p></div>
    <div class="has-dots"><svg class="deco dots dots-merch" aria-hidden="true"><rect width="100%" height="100%" fill="url(#dotk)"/></svg>
      <ul class="merch">
        <Fragment set:html={renderMerchItems(MERCH.items)} />
      </ul>
    </div>
    <p class="merch-note">Prices are set by the store and may change. Free shipping on most orders.</p>
  </div>
</section>
<section>
  <div class="wrap order">
    <div class="rv"><h2 class="ruled title-calm">How it works</h2>
      <ol class="steps">
        <li><b>Pick your gear</b><span>Choose an item, then your size and color in the store.</span></li>
        <li><b>Check out online</b><span>Orders are placed and paid for on Dogain Gear's site.</span></li>
        <li><b>Support the team</b><span>A portion of every order goes to Los Al Robotics.</span></li>
      </ol>
    </div>
    <div class="rv" style="--d:1">
      <p class="eyebrow" style="margin-bottom:10px">Sponsors</p>
      <p class="muted">Sponsors at the Griffin tier get a team T-shirt with their sponsorship.</p>
      <a class="sweep tier-link" href="/sponsors">See sponsor tiers →</a>
    </div>
  </div>
</section>
