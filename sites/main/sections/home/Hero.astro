---
import { media } from "../../lib/media";
---

<div class="hero">
  <img id="hero-img" src={media("team/4f1c204f9c.webp")} alt="Team 6220 students and mentors gathered around the robot in the pits, seen from above" fetchpriority="high">
  <div class="wrap">
    <p class="eyebrow load" style="--i:0"><span class="vh">FRC Team 6220</span><span class="eb-a" aria-hidden="true"><span class="w"><span>F</span><span>R</span><span>C</span></span> <span class="w"><span>T</span><span>e</span><span>a</span><span>m</span></span> <span class="w"><span>6</span><span>2</span><span>2</span><span>0</span></span></span><span class="eb-b"> · Los Alamitos High School</span></p>
    <h1 class="load" style="--i:1;margin-top:18px"><span class="vh">Golden Griffins</span><span class="h1-glyphs" aria-hidden="true"><span class="w"><span>G</span><span>o</span><span>l</span><span>d</span><span>e</span><span>n</span></span> <span class="w"><span>G</span><span>r</span><span>i</span><span>f</span><span>f</span><span>i</span><span>n</span><span>s</span></span></span></h1>
    <p class="lede load" style="--i:2">Student-led, student-driven. We design, build, and program a competition robot every season, and we teach the next crew how to do it.</p>
    <div class="ctas load" style="--i:3">
      <a class="btn btn-gold" href="/about/join">Join the team</a>
      <a class="btn btn-line" href="/sponsors">Support us</a>
      <a class="icon-btn" href="https://www.instagram.com/losalfrc_6220/" target="_blank" rel="noopener" aria-label="Team 6220 on Instagram"><svg aria-hidden="true"><use href="#ig"/></svg></a>
    </div>
  </div>
</div>
