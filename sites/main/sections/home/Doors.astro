---
import { media } from "../../lib/media";
---

<section class="home-doors angled angled-gold">
  <div class="wrap">
    <div class="sec-head rv"><div><p class="eyebrow ruled">Start here</p><h2 class="title-calm">Explore the team</h2></div></div>
    <div class="doors-wrap"><svg class="deco dots dots-1 px" data-depth="0.8" aria-hidden="true"><rect width="100%" height="100%" fill="url(#dotp)"/></svg>
    <nav class="doors" aria-label="Explore the team">
      <div class="door-wrap rv" style="--d:0"><a class="door" href="/about"><img src={media("team/2d048fe84f.webp")} alt="" loading="lazy"><p class="eyebrow">About</p><h3>Who we are</h3><p>Our mission, our six pillars, what students learn, and our mentors.</p><span class="go">About us <i>→</i></span></a></div>
      <div class="door-wrap rv" style="--d:1"><a class="door" href="/about/join"><img src={media("team/27bdee70e4.webp")} alt="" loading="lazy"><p class="eyebrow">Join</p><h3>Join the team</h3><p>For Los Al students in 8th to 12th grade. No experience needed: training starts every fall.</p><span class="go">Why join <i>→</i></span></a></div>
      <div class="door-wrap rv" style="--d:2"><a class="door" href="/sponsors"><img src={media("team/b5ea775824.webp")} alt="" loading="lazy"><p class="eyebrow">Sponsors</p><h3>Support the team</h3><p>Sponsor, donate, mentor, or volunteer. Your gift may be tax deductible.</p><span class="go">Ways to help <i>→</i></span></a></div>
      <div class="door-wrap rv" style="--d:3"><a class="door" href="/about/outreach"><img src={media("team/bc010b578b.webp")} alt="" loading="lazy"><p class="eyebrow">Outreach</p><h3>Beyond the shop</h3><p>Summer camps, the STEM Expo, and Open Workshop days, for students of all ages.</p><span class="go">Our programs <i>→</i></span></a></div>
    </nav>
    </div>
  </div>
</section>
