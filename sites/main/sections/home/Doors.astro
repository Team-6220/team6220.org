---
import { media } from "../../lib/media";
---

<section class="home-doors angled angled-gold">
  <div class="deco-layer" aria-hidden="true"><span class="deco feather f1 px" data-depth="1.1" aria-hidden="true"><svg class="float" style="--r:-24deg;--dur:7s;--dl:0s" viewBox="0 0 48 32"><use href="#feather"/></svg></span><span class="deco feather f2 px" data-depth="1.1" aria-hidden="true"><svg class="float" style="--r:38deg;--dur:8.5s;--dl:1.2s" viewBox="0 0 48 32"><use href="#feather"/></svg></span></div>
  <div class="wrap">
    <div class="sec-head rv"><div><p class="eyebrow ruled">Start here</p><h2 class="title-calm">Explore the team</h2></div></div>
    <div class="doors-wrap"><svg class="deco dots dots-1 px" data-depth="0.8" aria-hidden="true"><rect width="100%" height="100%" fill="url(#dotp)"/></svg>
    <nav class="doors" aria-label="Explore the team">
      <div class="door-wrap rv" style="--d:0"><a class="door" href="/about"><img src={media("team/2d048fe84f.webp")} alt="" loading="lazy"><p class="eyebrow">About</p><h3>Who we are</h3><p>Ten seasons, a Regional win, a rebuild, and a comeback.</p><span class="go">Our story <i>→</i></span></a></div>
      <div class="door-wrap rv" style="--d:1"><a class="door" href="/about/join"><img src={media("team/27bdee70e4.webp")} alt="" loading="lazy"><p class="eyebrow">Join</p><h3>Join the team</h3><p>No experience needed. Students teach students.</p><span class="go">How to join <i>→</i></span></a></div>
      <div class="door-wrap rv" style="--d:2"><a class="door" href="/support-us"><img src={media("team/b5ea775824.webp")} alt="" loading="lazy"><p class="eyebrow">Sponsors</p><h3>Fuel the build</h3><p>Three tiers, a 501(c)(3) booster, a $45K season.</p><span class="go">Sponsor tiers <i>→</i></span></a></div>
      <div class="door-wrap rv" style="--d:3"><a class="door" href="/about/outreach"><img src={media("team/bc010b578b.webp")} alt="" loading="lazy"><p class="eyebrow">Outreach</p><h3>Beyond the shop</h3><p>Summer camp, STEM Expo, and open workshop days.</p><span class="go">Our programs <i>→</i></span></a></div>
    </nav>
    </div>
  </div>
</section>
