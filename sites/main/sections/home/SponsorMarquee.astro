---
import { renderSponsorMarquee } from "@team6220/content";
import { SPONSORS } from "../../data/sponsors";
---
<section style="padding-block:var(--s5)">
  <div class="wrap sponsor-head rv"><h2 class="title-calm winged"><span class="wing wing-l" aria-hidden="true"><svg><use href="#wing"/></svg></span><span class="wt">Thank you to our sponsors</span><span class="wing wing-r" aria-hidden="true"><svg><use href="#wing"/></svg></span></h2></div>
  <div class="marquee" aria-label="Sponsors">
    <div class="marquee-track">
      <Fragment set:html={renderSponsorMarquee(SPONSORS)} />
    </div>
  </div>
  <div class="wrap" style="text-align:center;margin-top:var(--s3)"><a class="btn btn-ghost" style="color:var(--gold)" href="/sponsors#sponsor-list">See all sponsors</a></div>
</section>
