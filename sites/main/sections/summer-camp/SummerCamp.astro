import { renderBlocks } from "@team6220/content";
import { SUMMER_CAMP } from "../../config/site";
---
<!--
  Ported as-is from the old Wix page (www.team6220.org/summer, November 2026): same text and links,
  plain layout. The team will rewrite and restyle it (#69). The old site writes zeros as "o" for its
  font; here they are plain digits.
-->
<section class="on-paper angled angled-gold">
  <div class="wrap camp-copy">
    <Fragment set:html={renderBlocks(SUMMER_CAMP.blocks)} />
  </div>
</section>
