---
// Join page, part 3: how to join. From the onboarding deck, the 2026-27 application, and the 2026 Onboarding Checklist.
const STEPS = [
  { title: "Sign up for our newsletter", text: "We recruit once a year, in September, and can't add new members mid-year. Sign up below and we'll tell you when recruiting opens." },
  { title: "Come to the onboarding meeting", text: "Learn about <i>FIRST</i>, our team, and our subteams. Parents have their own parent meeting the same week." },
  { title: "Train for a week", text: "Training week is a preview of build season: meetings every day after school until 5:00. Come every day you can; you need at least three days to join." },
  { title: "Apply", text: "Submit the team application by the end of training week. It isn't meant to keep anyone out: we have 35 spots (25 technical, 10 operations) so everyone has real work to do. Current and former members, and students from our summer camp, get priority." },
  { title: "Finish onboarding", text: "Turn in the signed handbook and safety contract, pass the safety quiz, join our Discord, register on firstinspires.org, and pick your main subteam." },
];
---

<section class="on-panel">
  <div class="wrap">
    <div class="sec-head rv"><div><p class="eyebrow ruled">How to join</p><h2 class="title-calm">Five steps</h2></div><p>Open to Los Alamitos Unified students in grades 8 through 12.</p></div>
    <ol class="join-steps">
      {STEPS.map((s, i) => (
        <li class="rv" style={`--d:${i}`}><b>{s.title}</b><span set:html={s.text} /></li>
      ))}
    </ol>
  </div>
</section>
