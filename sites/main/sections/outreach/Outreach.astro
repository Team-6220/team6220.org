---
import { media } from "../../lib/media";
---

<section class="on-ink angled angled-gold">
  <div class="wrap">
    <div class="has-dots"><svg class="deco dots dots-prog" aria-hidden="true"><rect width="100%" height="100%" fill="url(#dotp)"/></svg><div class="programs">
      <article class="rv" style="--d:0"><p class="eyebrow">Summer</p><h3>Robotics Summer Camp</h3><p>A three-week camp that students propose and run with the Los Alamitos Education Foundation. In 2025 it raised <b>$6,000</b>, and <b>60%</b> of campers joined the team.</p></article>
      <article class="rv" style="--d:1"><p class="eyebrow">On campus</p><h3>STEM Expo</h3><p>Built with other Los Al STEM clubs as the school's first campus-wide STEM event since COVID. We're working with LAEF on a grant to bring back the STEAM Fair.</p></article>
      <article class="rv" style="--d:2"><p class="eyebrow">Hands-on</p><h3>Open Workshop days</h3><p>Any student can come into our shop and build something. We also bring the robot to community and sponsor events.</p></article>
    </div></div>

    <div class="sub-head rv" id="gallery"><div><h2 class="ruled title-calm">Media</h2></div><a class="btn btn-line" href="/resources/media">See all photos →</a></div>
    <ul class="gallery">
      <li class="g1 photo-card rv" style="--d:0"><div class="pc-in"><img src={media("team/4f1c204f9c.webp")} alt="Students and mentors working on the robot in the pits, seen from above" loading="lazy"></div></li>
      <li class="photo-card tl-l rv" style="--d:1"><div class="pc-in"><img src={media("team/27bdee70e4.webp")} alt="Drive team members in 6220 hoodies at the driver station during a match" loading="lazy"></div></li>
      <li class="photo-card rv" style="--d:2"><div class="pc-in"><img src={media("team/2d048fe84f.webp")} alt="Team members smiling up at the camera in the pits" loading="lazy"></div></li>
      <li class="g2 photo-card tl-l rv" style="--d:3"><div class="pc-in"><img src={media("team/bc010b578b.webp")} alt="Team 6220 members and visitors gathered at the pit under the Golden Griffins banner" loading="lazy"></div></li>
      <li class="g2 photo-card rv" style="--d:4"><div class="pc-in"><img src={media("team/b5ea775824.webp")} alt="Overhead view of the Team 6220 pit at competition" loading="lazy"></div></li>
    </ul>

    <div class="sub-head rv" id="social"><div><h2 class="ruled title-calm">Follow along</h2></div><a class="btn btn-gold" href="https://www.instagram.com/losalfrc_6220/" target="_blank" rel="noopener">Instagram @losalfrc_6220 ↗</a></div>
  </div>
</section>
