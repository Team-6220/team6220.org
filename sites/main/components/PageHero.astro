---
// Banner at the top of every page except Home: photo, winged eyebrow, big title, one line of text.
// Anything in the slot (e.g. buttons) goes under the text.
interface Props {
  /** Background photo URL */
  img: string;
  eyebrow: string;
  /** Title; may contain <br> */
  title: string;
  lede?: string;
}
const { img, eyebrow, title, lede } = Astro.props;
---

<div class="page-hero banner"><img class="ph-img" src={img} alt="" aria-hidden="true"><div class="wrap"><p class="eyebrow lift winged"><span class="wing wing-l" aria-hidden="true"><svg><use href="#wing"/></svg></span><span class="wt">{eyebrow}</span><span class="wing wing-r" aria-hidden="true"><svg><use href="#wing"/></svg></span></p><h1 class="title-hero" set:html={title} />{lede && <p class="lift">{lede}</p>}<slot /></div></div>
