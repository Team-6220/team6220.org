/**
 * Extra stock added around each part by the cut planner (inches, added to
 * BOTH length and width; the result is rounded UP to the nearest 1/8").
 *   Handmade: a little tolerance.
 *   Shapeoko: room for clamping/tabs — 1" for thin stock (under 1/4"), 0.75" for 1/4" and thicker.
 * The browser has a copy of these numbers in JsPlanner.html (CUT_RULES).
 */
const CUT_RULES = { handmadeExtra: 0.25, shapeokoThinExtra: 1, shapeokoThickExtra: 0.75, thickFrom: 0.25, roundTo: 0.125 };

const CONFIG_SHEET = 'Config';

/** Tables the browser loads (audit tables are read-only to the browser; they change through ApiAudit.gs). */
function clientTableKeys_() {
  return Object.keys(TABLES).filter(function (k) {
    return ['inventory', 'setting', 'audit', 'packing', 'production'].indexOf(TABLES[k].kind) >= 0;
  });
}

