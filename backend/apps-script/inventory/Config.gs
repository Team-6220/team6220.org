  ROOT_FOLDER_NAME: 'Golden Griffins Inventory',
  IMAGE_FOLDER_NAME: 'Item Images',
  BACKUP_FOLDER_NAME: 'Backups',
  BACKUP_PREFIX: 'Inventory Backup ',
  BACKUP_MAX_AGE_DAYS: 90,               // backups older than ~3 months are trashed…
  BACKUP_MIN_KEEP: 3,                    // …but the newest 3 are always kept
  BACKUP_HOUR: 3,                        // 3 AM, in the script's time zone
  BACKUP_MIN_INTERVAL_MS: 60 * 60 * 1000, // a backup can't run more than once an hour
  ARCHIVE_PURGE_DAYS: 30,                // archived items are permanently deleted after this
  LOCK_WAIT_MS: 20000,                   // how long a write waits for its turn
