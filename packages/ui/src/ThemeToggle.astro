---
// The one light/dark button, shared by every app page (AppLayout puts it on the page).
// The choice is saved in the browser under THEME_KEY; the default is dark and the device setting is ignored.
// AppLayout applies the saved choice in <head>, before the page is drawn, so there is no flash.
// Icons are drawn like the Inventory icon set (24px grid, 1.8 stroke).
---

<button class="t-theme-toggle" type="button" data-theme-toggle aria-label="Switch between light and dark mode" title="Light / dark mode">
  <svg class="t-theme-toggle__sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M18.4 5.6L17 7M7 17l-1.4 1.4"/></svg>
  <svg class="t-theme-toggle__moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
</button>
<script is:inline>
  document.querySelectorAll("[data-theme-toggle]").forEach(function (button) {
    button.addEventListener("click", function () {
      var next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem("team6220.theme", next);
      } catch (e) {
        // Storage is blocked (private window): the choice still applies until the page is closed.
      }
    });
  });
</script>
