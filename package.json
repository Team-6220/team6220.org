{
  "name": "team6220-org",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "FRC Team 6220 (Golden Griffins) website and team apps",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "redirects:csv": "node scripts/redirects/csv.mjs",
    "redirects:check": "node scripts/redirects/check.mjs",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "build:e2e-mock": "node e2e/build-mock.mjs",
    "test:e2e:build": "pnpm build && pnpm build:e2e-mock && pnpm test:e2e",
    "content:check": "pnpm --filter @team6220/content validate"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "astro": "^7.4.7",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.4",
    "@team6220/attendance": "workspace:*",
    "@team6220/bom": "workspace:*",
    "@team6220/content": "workspace:*",
    "@team6220/dashboard": "workspace:*",
    "@team6220/data": "workspace:*",
    "@team6220/site": "workspace:*",
    "@team6220/template": "workspace:*",
    "@team6220/ui": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
