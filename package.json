{
  "name": "goldsim",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source, browser-based 2D FRC strategy and design simulator",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @goldsim/web",
    "build": "npm run build -w @goldsim/web",
    "preview": "npm run preview -w @goldsim/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "validate-game": "tsx packages/schema/src/cli/validate-game.ts",
    "spike": "tsx packages/core/spike/run.ts",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
